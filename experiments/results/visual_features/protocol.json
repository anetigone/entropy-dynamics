{
  "dataset": "CIFAR-10",
  "splits": [
    "official train",
    "official test"
  ],
  "architecture": "ResNet-18",
  "checkpoint": "models/resnet-18",
  "data_root": "data/cifar10",
  "cache_dir": null,
  "device": "cuda",
  "batch_size": 128,
  "preprocessing": {
    "crop_pct": 0.875,
    "do_normalize": true,
    "do_rescale": true,
    "do_resize": true,
    "image_mean": [
      0.485,
      0.456,
      0.406
    ],
    "image_processor_type": "ConvNextImageProcessor",
    "image_std": [
      0.229,
      0.224,
      0.225
    ],
    "resample": 3,
    "rescale_factor": 0.00392156862745098,
    "size": {
      "shortest_edge": 224
    }
  },
  "feature": "Frozen 512-dimensional average pool; eval mode",
  "classes": [
    "airplane",
    "automobile",
    "bird",
    "cat",
    "deer",
    "dog",
    "frog",
    "horse",
    "ship",
    "truck"
  ],
  "no_training": true
}